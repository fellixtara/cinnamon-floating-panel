{
    "layout": {
        "type": "layout",
        "pages": [
            "page-general",
            "page-appearance"
        ],
        "page-general": {
            "type": "page",
            "title": "General panel options",
            "sections": [
                "sec-split",
                "sec-margins",
                "sec-shape"
            ]
        },
        "page-appearance": {
            "type": "page",
            "title": "Appearance",
            "sections": [
                "sec-colour",
                "sec-icons",
                "sec-menu",
                "sec-submenu"
            ]
        },
        "sec-split": {
            "type": "section",
            "title": "Zones",
            "keys": [
                "separate",
                "gap"
            ]
        },
        "sec-margins": {
            "type": "section",
            "title": "Margin (space between the panel and the screen edges)",
            "keys": [
                "margin-top",
                "margin-right",
                "margin-bottom",
                "margin-left"
            ]
        },
        "sec-shape": {
            "type": "section",
            "title": "Shape",
            "keys": [
                "radius",
                "padding"
            ]
        },
        "sec-colour": {
            "type": "section",
            "title": "Panel background",
            "keys": [
                "background",
                "transparency"
            ]
        },
        "sec-menu": {
            "type": "section",
            "title": "Dropdown menus (main)",
            "keys": [
                "menu-custom",
                "menu-background",
                "menu-transparency",
                "menu-text",
                "gtk-menus"
            ]
        },
        "sec-submenu": {
            "type": "section",
            "title": "Dropdown menus (secondary / submenu)",
            "keys": [
                "submenu-background",
                "submenu-transparency",
                "submenu-text"
            ]
        },
        "sec-icons": {
            "type": "section",
            "title": "Right panel icons",
            "keys": [
                "icon-tint",
                "icon-color"
            ]
        }
    },
    "separate": {
        "type": "switch",
        "default": false,
        "description": "Separate the panel into left, center and right",
        "tooltip": "Each zone with applets becomes its own pill, as wide as its applets. Empty zones are not drawn."
    },
    "gap": {
        "type": "spinbutton",
        "default": 8,
        "min": 0,
        "max": 80,
        "step": 1,
        "units": "px",
        "dependency": "separate",
        "description": "Gap between the zones",
        "tooltip": "The smallest space kept between two pills when the zones grow towards each other."
    },
    "margin-top": {
        "type": "spinbutton",
        "default": 4,
        "min": 0,
        "max": 60,
        "step": 1,
        "units": "px",
        "description": "Top"
    },
    "margin-right": {
        "type": "spinbutton",
        "default": 8,
        "min": 0,
        "max": 400,
        "step": 1,
        "units": "px",
        "description": "Right"
    },
    "margin-bottom": {
        "type": "spinbutton",
        "default": 4,
        "min": 0,
        "max": 60,
        "step": 1,
        "units": "px",
        "description": "Bottom"
    },
    "margin-left": {
        "type": "spinbutton",
        "default": 8,
        "min": 0,
        "max": 400,
        "step": 1,
        "units": "px",
        "description": "Left"
    },
    "radius": {
        "type": "spinbutton",
        "default": 15,
        "min": 0,
        "max": 60,
        "step": 1,
        "units": "px",
        "description": "Rounded corners",
        "tooltip": "Half of the panel height or more gives fully rounded ends, like a pill."
    },
    "padding": {
        "type": "spinbutton",
        "default": 8,
        "min": 0,
        "max": 40,
        "step": 1,
        "units": "px",
        "description": "Space between the edge of a pill and its applets"
    },
    "background": {
        "type": "colorchooser",
        "default": "rgb(30,30,36)",
        "description": "Background colour"
    },
    "transparency": {
        "type": "scale",
        "default": 15,
        "min": 0,
        "max": 100,
        "step": 1,
        "description": "Transparency (%)",
        "tooltip": "0 is solid, 100 is invisible."
    },
    "menu-custom": {
        "type": "switch",
        "default": true,
        "description": "Use these colours for the dropdown menus",
        "tooltip": "Applies to the menus opened from the panel applets (sound, network, menu, ...) and to their expandable sections. Off keeps the theme's colours."
    },
    "menu-background": {
        "type": "colorchooser",
        "default": "rgb(33,33,33)",
        "dependency": "menu-custom",
        "description": "Background colour"
    },
    "menu-transparency": {
        "type": "scale",
        "default": 5,
        "min": 0,
        "max": 100,
        "step": 1,
        "dependency": "menu-custom",
        "description": "Transparency (%)",
        "tooltip": "0 is solid, 100 is invisible."
    },
    "menu-text": {
        "type": "colorchooser",
        "default": "rgb(255,255,255)",
        "dependency": "menu-custom",
        "description": "Text colour"
    },
    "submenu-background": {
        "type": "colorchooser",
        "default": "rgb(48,48,52)",
        "dependency": "menu-custom",
        "description": "Background colour"
    },
    "submenu-transparency": {
        "type": "scale",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 1,
        "dependency": "menu-custom",
        "description": "Transparency (%)",
        "tooltip": "0 is solid, 100 is invisible."
    },
    "submenu-text": {
        "type": "colorchooser",
        "default": "rgb(235,235,235)",
        "dependency": "menu-custom",
        "description": "Text colour"
    },
    "gtk-menus": {
        "type": "switch",
        "default": true,
        "dependency": "menu-custom",
        "description": "Also colour the menus of tray apps (Bluetooth, Slack, ...)",
        "tooltip": "Tray icons show their own GTK menus. Their colours go into ~/.config/gtk-3.0/gtk.css, so the right-click menus of other GTK 3 apps change too. Apps read that file when they start: the tray service is restarted, other apps change at their next start."
    },
    "icon-tint": {
        "type": "switch",
        "default": false,
        "description": "Give all icons in the right zone one colour",
        "tooltip": "On: every icon and text in the right zone (tray, sound, network, ...) is drawn in the colour below, as a flat shape. Off: each app keeps its own colours."
    },
    "icon-color": {
        "type": "colorchooser",
        "default": "rgb(255,255,255)",
        "dependency": "icon-tint",
        "description": "Icon colour"
    }
}
